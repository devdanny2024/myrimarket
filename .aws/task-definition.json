{
  "family": "myri-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "REPLACE_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "myri-api",
      "image": "REPLACE_IMAGE",
      "essential": true,
      "portMappings": [
        { "containerPort": 4001, "hostPort": 4001, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "PORT", "value": "4001" },
        { "name": "WEB_ORIGIN", "value": "REPLACE_WEB_ORIGIN" },
        { "name": "ADMIN_TOKEN", "value": "REPLACE_ADMIN_TOKEN" },
        { "name": "DATABASE_URL", "value": "REPLACE_DATABASE_URL" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/myri-api",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
